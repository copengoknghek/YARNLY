NODE_ENV=development
PORT=5000

# Frontend origin(s) allowed by CORS (comma-separated for multiple)
CLIENT_URL=http://localhost:5173

# PostgreSQL
# Local npm run dev: localhost | Docker Compose backend service: postgres
# Vercel + Neon: use DATABASE_URL from the Neon integration (pooled URL, sslmode=require)
DB_URI=postgresql://yarnly:yarnly@localhost:5432/yarnly

# Secret used to sign JWT tokens (required in production)
JWT_SECRET=change-me

# Create demo staff/seller accounts and catalog on seed (set true for local/Docker demo)
SEED_DEMO=true

# Protects GET /api/cron/cleanup-guest-orders (Vercel Cron sends Bearer CRON_SECRET)
CRON_SECRET=

# SMTP (Gmail). SMTP_PASS là App Password 16 ký tự, không phải mật khẩu Gmail.
# Tạo tại https://myaccount.google.com/apppasswords (cần bật xác minh 2 bước).
# Để trống SMTP_USER/SMTP_PASS thì backend bỏ qua việc gửi email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Yarnly <your-email@gmail.com>"

# Test database (optional, used by npm test)
TEST_DB_URI=postgresql://yarnly:yarnly@localhost:5432/yarnly_test
