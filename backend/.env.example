NODE_ENV=development
PORT=5000

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# PostgreSQL
# Local npm run dev: localhost | Docker Compose backend service: postgres
DB_URI=postgresql://yarnly:yarnly@localhost:5432/yarnly

# Secret used to sign JWT tokens
JWT_SECRET=change-me

# SMTP (Gmail). SMTP_PASS là App Password 16 ký tự, không phải mật khẩu Gmail.
# Tạo tại https://myaccount.google.com/apppasswords (cần bật xác minh 2 bước).
# Để trống SMTP_USER/SMTP_PASS thì backend bỏ qua việc gửi email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Yarnly <your-email@gmail.com>"

# Test database (optional, used by npm test)
TEST_DB_URI=postgresql://yarnly:yarnly@localhost:5432/yarnly_test
