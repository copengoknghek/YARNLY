{
  "name": "yarnly-backend",
  "version": "1.0.0",
  "private": true,
  "description": "YARNLY e-commerce REST API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "vercel-build": "node scripts/vercel-build.js",
